{
  "name": "nori-web",
  "private": true,
  "version": "0.1.0",
  "description": "Nori email client web UI (standalone; future GPUI host embeds the built dist/)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3001",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
